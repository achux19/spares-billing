# Copy to /opt/spares/<stack>/.env  (chmod 600). Never commit the real one.
STACK=staging
VERSION=1.0.0-rc1
DB_NAME=spares_billing
DB_USER=spares
# generate: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME
# generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME
# public address of this stack (https, no trailing slash)
CORS_ORIGINS=https://staging.achux.in
# first-start owner account; change the password inside the app after first login
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=CHANGE_ME_STRONG
# platform Super Admin (no shop). Created once at first start; change the password after first login.
SUPER_ADMIN_USERNAME=Super Admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG
# backups (optional until rclone is set up), e.g. b2:spares-backups
RCLONE_REMOTE=
# healthchecks.io ping URL (optional)
HC_PING_URL=
